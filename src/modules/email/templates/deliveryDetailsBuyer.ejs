<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Delivery Scheduled</title>
  </head>
  <body style="font-family: Arial, sans-serif; background-color: #f5f5f5; padding: 20px;">
    <table width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; padding: 20px; border-radius: 8px;">
      <tr>
        <td>
          <h2 style="color: #333333;">Your delivery is scheduled</h2>

          <p style="color: #555555;">Hi <%= buyerName %>,</p>

          <p style="color: #555555;">
            The seller is ready to deliver your order. Here are the delivery details:
          </p>

          <table width="100%" cellspacing="0" cellpadding="8" style="margin: 20px 0; border: 1px solid #e0e0e0; border-radius: 4px;">
            <tr style="background-color: #f9f9f9;">
              <td style="color: #888888; font-size: 13px;">Order ID</td>
              <td style="color: #333333; font-weight: bold;"><%= orderNumber %></td>
            </tr>
            <tr>
              <td style="color: #888888; font-size: 13px;">Date</td>
              <td style="color: #333333;"><%= deliveryDate %></td>
            </tr>
            <tr style="background-color: #f9f9f9;">
              <td style="color: #888888; font-size: 13px;">Time</td>
              <td style="color: #333333;"><%= deliveryTime %></td>
            </tr>
            <tr>
              <td style="color: #888888; font-size: 13px;">Location</td>
              <td style="color: #333333;"><%= deliveryLocation %></td>
            </tr>
          </table>

          <p style="color: #555555;">
            A <strong>delivery code</strong> has been generated for you. Open the app to view it and show it to the seller at the delivery point.
          </p>

          <p style="color: #999999; font-size: 12px;">
            The delivery code is valid within ±2 hours of the scheduled delivery time.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
