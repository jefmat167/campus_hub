# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Public URLs
# PUBLIC_BASE_URL - the origin users reach THIS API at (scheme + host, no path).
# Email links to the server-rendered pages (verify-email, reset-password) are
# built as <PUBLIC_BASE_URL>/api/v1/auth/..., so on a deployed server set it to
# the public address (e.g. https://api.campushub.ng), never localhost.
# Required - startup fails without it. A value with a path is rejected.
PUBLIC_BASE_URL=http://localhost:3000
# FRONTEND_URL - the client app's URL, used only for links INTO the app
# (e.g. the "log in" link in account-deletion reminder emails).
FRONTEND_URL=http://localhost:5173
# API_SERVER - the server URL shown in Swagger's server picker (/docs). Required.
API_SERVER=http://localhost:3000

# Database (PostgreSQL)
# Option 1: Use connection URL (recommended)
DATABASE_URL=postgresql://postgres:password@localhost:5432/campushub

# Option 2: Use individual parameters (fallback if DATABASE_URL not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=campus_hub
# DB_PASSWORD=your_secure_password
# DB_NAME=campus_hub

# Echo every SQL statement to the console (very noisy). Off = errors, warnings, schema/migration output and queries slower than 1s only.
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d

# Termii (SMS OTP)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=CampusHub

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=campus-hub-uploads

# Cloudinary (backup storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 (presigned URL uploads)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=campus-hub-uploads
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Anonymous Posts Secret
ANONYMOUS_SECRET=your-anonymous-secret-key-min-32-characters-long

# Resend (Email)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=CampusHub <noreply@campushub.ng>

# Bull Board (Queue Dashboard) - Required in production
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=your_secure_dashboard_password

# Escrow / marketplace money tuning (all optional — defaults shown)
# ESCROW_PLATFORM_FEE_PERCENT=2.5
# VENDOR_PLATFORM_FEE_PERCENT=2.5
# ESCROW_CANCELLATION_FEE_PERCENT=10
# ESCROW_FULFILLMENT_HOURS=72
# ESCROW_DISPUTE_WINDOW_MINUTES=1440

# Marketplace rev-2 timing knobs (all optional — defaults shown)
# ORDER_CONFIRMATION_HOURS=24
# SERVICE_AGREEMENT_HOURS=72
# SERVICE_APPOINTMENT_HORIZON_DAYS=14
# SERVICE_NO_SHOW_GRACE_MINUTES=30
# SERVICE_APPOINTMENT_BACKSTOP_HOURS=24
# SERVICE_PROPOSAL_EXPIRY_HOURS=48
# OFFER_LOCK_HOURS=24
